<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Audio Pro para Premiere</title>
    <organization>com.danielgutierrez</organization>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Apple Silicon only: the bundled ffmpeg/ffprobe are arm64 static
         builds (scripts/fetch-bin.sh). An Intel Mac gets a clear refusal
         here instead of a panel that fails at the first render. -->
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>

    <!-- Everything goes under /Library/Application Support/AudioPro; the
         postinstall script is what copies the panel into the logged-in
         user's own CEP extensions directory. -->
    <choices-outline>
        <line choice="default">
            <line choice="com.danielgutierrez.audiopro.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.danielgutierrez.audiopro.pkg" visible="false">
        <pkg-ref id="com.danielgutierrez.audiopro.pkg"/>
    </choice>
    <pkg-ref id="com.danielgutierrez.audiopro.pkg">AudioProPremiere.pkg</pkg-ref>
</installer-gui-script>
